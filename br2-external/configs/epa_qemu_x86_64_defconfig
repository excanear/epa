# EPA Buildroot defconfig for QEMU x86_64

BR2_x86_64=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EPA_PATH)/../kernel/epa_qemu_defconfig"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# No init system provided by Buildroot - EPA's own epa-init is PID 1
BR2_INIT_NONE=y

# EPA itself
BR2_PACKAGE_EPA=y

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set

# Root filesystem overlay (default /etc/epa.conf, motd, ...)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_EPA_PATH)/board/epa/qemu/rootfs-overlay"

# host-qemu so `make run` can boot the image directly
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_HOST_QEMU_SYSTEM_MODE=y
